# ---- 模型接入（OpenAI 兼容协议）----
# 开发建议用 DeepSeek 或 DashScope 的 Qwen 兼容端点；切 OpenAI 只需改这三项。
DR_DEFAULT_BASE_URL=https://api.deepseek.com/v1
DR_DEFAULT_API_KEY=sk-your-key-here
DR_DEFAULT_MODEL=deepseek-chat

# ---- 按角色覆盖模型（可选；留空则回退到 DEFAULT_*）----
# 成本策略：Researcher 用便宜快模型跑量，Critic/Writer 用强模型保质。
# 注意：若 DR_RESEARCHER_MODEL 与 DR_CRITIC_MODEL 相同，则关闭低置信自动升级。
DR_PLANNER_MODEL=deepseek-chat
DR_RESEARCHER_MODEL=deepseek-chat
DR_CRITIC_MODEL=deepseek-reasoner
DR_WRITER_MODEL=deepseek-chat

# ---- 研究行为参数 ----
DR_MAX_SUB_QUESTIONS=6
DR_MAX_CRITIQUE_ROUNDS=2
DR_MAX_RESEARCHER_STEPS=8
DR_EVIDENCE_CONTENT_LIMIT=4000
# Researcher 自评置信度低于该值时，用 Critic 的强模型重跑一次提取
DR_ESCALATION_CONFIDENCE_THRESHOLD=0.6

# ---- MCP servers（JSON；命令需能被 mcp_client 以 stdio 启动）----
# 使用方式：uv run python -m mcp_servers.arxiv_server
DR_MCP_SERVERS={"arxiv": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.arxiv_server"]}, "github": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.github_server"], "env": {"GITHUB_TOKEN": ""}}, "web": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.web_server"], "env": {"TAVILY_API_KEY": ""}}}

# ---- 持久化 ----
DR_CHECKPOINT_DB_PATH=checkpoints.sqlite3

# ---- MCP server 侧密钥（供上面 env 或直接导出）----
GITHUB_TOKEN=
TAVILY_API_KEY=
# 备选搜索后端（未配 TAVILY 时生效；两者都无则退化为 DuckDuckGo 免密钥抓取）
BRAVE_API_KEY=
