# ---- 模型接入（OpenAI 兼容协议）----
# 开发建议用 DeepSeek 或 DashScope 的 Qwen 兼容端点；切 OpenAI 只需改这三项。
DR_DEFAULT_BASE_URL=https://api.deepseek.com/v1
DR_DEFAULT_API_KEY=sk-your-key-here
DR_DEFAULT_MODEL=deepseek-chat

# ---- 按角色覆盖模型（可选；留空则回退到 DEFAULT_*）----
# 成本策略：把贵模型用在"调用次数少、对质量敏感"的环节。
#   Researcher 是最费 token 的角色（ReAct 多轮 + 工具返回长正文），用便宜快模型跑量；
#   Critic 只做审校与要点核对，调用少，可以用更强的模型。
# 也可按角色指向不同厂商（必须 OpenAI 兼容）：
#   DR_CRITIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   DR_CRITIC_API_KEY=sk-xxx
#   DR_CRITIC_MODEL=qwen-max
DR_PLANNER_MODEL=deepseek-chat
DR_RESEARCHER_MODEL=deepseek-chat
DR_CRITIC_MODEL=deepseek-reasoner
DR_WRITER_MODEL=deepseek-chat

# ---- 研究行为参数 ----
DR_MAX_SUB_QUESTIONS=6
DR_MAX_CRITIQUE_ROUNDS=2
DR_MAX_RESEARCHER_STEPS=8
# 单条抓取正文保留的字符数：4000 会把论文结果表格截掉（实测某题覆盖 50%→100% 的差别）
DR_EVIDENCE_CONTENT_LIMIT=12000

# ---- MCP servers（JSON；命令需能被 mcp_client 以 stdio 启动）----
# 使用方式：uv run python -m mcp_servers.arxiv_server
DR_MCP_SERVERS={"arxiv": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.arxiv_server"]}, "github": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.github_server"], "env": {"GITHUB_TOKEN": ""}}, "web": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.web_server"], "env": {"TAVILY_API_KEY": ""}}}

# ---- 信源模式 ----
# online ：联网取证（arxiv/github/web），默认
# offline：只读本地知识库，**不联网取证**（内网/保密场景的取证侧）
#   注意：offline 只约束信源，不约束算力——LLM/embedding 仍可走 API
#   用法：DR_SOURCE_MODE=offline + 下面的 kb 条目（network=false）
#   知识库入库：python scripts/ingest_kb.py <目录或文件>（支持 .md/.txt）
#   离线引用核验到「文件 + 章节」，强于线上的 URL 可达性检查
DR_SOURCE_MODE=online
# 离线模式下的 MCP 配置（只装 kb；network=false 才会在 offline 下保留）：
# DR_MCP_SERVERS={"kb": {"transport": "stdio", "command": "python", "args": ["-m", "mcp_servers.kb_server"], "network": false}}

# ---- 持久化 ----
DR_CHECKPOINT_DB_PATH=checkpoints.sqlite3
# 默认 postgres：检查点与 pgvector 长期记忆同库（先 docker compose up -d postgres）
# 仅当需要零依赖本地跑时才显式改成 sqlite
DR_CHECKPOINT_BACKEND=postgres
DR_DATABASE_URL=postgresql://deepresearch:deepresearch@localhost:5432/deepresearch

# ---- 长期记忆（需 DR_CHECKPOINT_BACKEND=postgres 且已装 pgvector 扩展）----
DR_ENABLE_LONG_TERM_MEMORY=false
DR_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DR_MEMORY_RECALL_LIMIT=5

# ---- 知识库检索（切块入库 + 三路融合 + 可选精排）----
# provider 与「信源模式」正交：offline 只约束信源（不联网取证），不约束算力。
#   local：fastembed 本地推理，零 API 成本、可断网；但 bge-small-zh 是中文小模型，
#          在英文财报上页面命中@10 只有 14%（实测，见 docs/检索基准-FinanceBench.md）
#   api  ：OpenAI 兼容的 /embeddings，多语言大模型可到 38%，配 query 扩展 + 精排到 57%
DR_EMBEDDING_PROVIDER=local
DR_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DR_EMBEDDING_API_KEY=
DR_EMBEDDING_API_MODEL=text-embedding-v4
DR_EMBEDDING_API_DIM=1024
DR_EMBEDDING_API_BATCH=10

# 精排（可选）：检索失败常是"正确的页排在 30 位"，rerank 治排序、不治召回。
# 实测 @1 从 14%→29%，@50 不变（召回上限由 embedding 决定）。
DR_RERANK_PROVIDER=none
DR_RERANK_API_BASE=
DR_RERANK_API_KEY=
DR_RERANK_API_MODEL=
DR_RERANK_CANDIDATES=50

# 查询扩展：把问题改写成几条术语查询后多路融合检索。
# 实测召回@50 从 76% → 90%（问题说"流动性是否健康"、页面只有 Current ratio，没共同词）；
# 代价是每次检索多 1 次 LLM 调用（约 +4s），所以默认关闭，演示/评测再开。
DR_QUERY_EXPANSION=false
DR_QUERY_EXPANSION_N=3

# 知识库表名：不同维度必须分表（本地 512 / API 1024），A/B 对比模型时靠它切换
DR_KB_TABLE=kb_chunks
# 知识库文件根目录：kb 里存**相对路径**，解析时拼到这里（容器内即 /app）
DR_KB_ROOT=.

# ---- 可观测性（Langfuse；装上 langfuse 依赖后自动生效）----
# 只要填了 key 就开启追踪；留空则完全旁路（不导入、不报错）
DR_LANGFUSE_PUBLIC_KEY=
DR_LANGFUSE_SECRET_KEY=
# 云端免费层；自建填 http://localhost:3000
DR_LANGFUSE_HOST=https://cloud.langfuse.com
# 显式开关：留空=自动（有 key 即开）；true=强制开（无 key 直接报错）；false=强制关
DR_LANGFUSE_ENABLED=

# ---- MCP server 侧密钥（供上面 env 或直接导出）----
GITHUB_TOKEN=
TAVILY_API_KEY=
# 备选搜索后端（未配 TAVILY 时生效；两者都无则退化为 DuckDuckGo 免密钥抓取）
BRAVE_API_KEY=
